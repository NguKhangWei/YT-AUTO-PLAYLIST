# Settings for the auto-yt server: /etc/auto-yt/auto-yt.env on the VM
# (owner root, group autoyt, mode 640). Never commit the filled-in copy.

# The Desktop OAuth client from your Google Cloud project (same values as the
# repo .env, without the MAIN_VITE_ prefix).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database, sign-in and backups live here.
AUTO_YT_DATA_DIR=/var/lib/auto-yt

# Listens on 127.0.0.1 only; `sudo tailscale serve --bg 8080` publishes it to your tailnet.
AUTO_YT_PORT=8080

# The Tailscale login allowed to use the web UI (Tailscale admin console -> machine -> Creator).
AUTO_YT_ALLOWED_LOGIN=

# Push notifications: a long random ntfy topic (16+ characters). Leave empty for none.
NTFY_TOPIC=

# on: detect Shorts with YouTube's /shorts/ check. off: every video of 3 minutes or less is a Short.
SHORTS_PROBE=on
